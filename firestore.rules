rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;

      match /cats/{catId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /sightings/{sightingId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          // Sighting writes go through the client for create; sightingCount/
          // lastSeenAt on the parent cat are corrected server-side by the
          // onSightingWritten Cloud Function (Admin SDK bypasses these rules).
          allow create: if request.auth != null && request.auth.uid == uid;
        }
      }

      match /unlockedAchievements/{achievementId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Only the achievements Cloud Function (Admin SDK) unlocks these.
        allow write: if false;
      }
    }
  }
}
